[global]
repo1-path=/backup/repository
repo1-cipher-type=aes-256-cbc
# Add repo1-cipher-pass to the private mounted configuration, never commit it.
repo1-retention-full=2
repo1-retention-diff=7
start-fast=y
archive-async=n
archive-timeout=120
log-level-console=warn
log-level-file=off

[booking]
pg1-path=/var/lib/postgresql/18/docker
pg1-user=booking_owner
pg1-database=booking
