# Local development only. Copy to .env.local. Never reuse these credentials on a server.
DATABASE_URL=postgresql://booking_app:local_app_only@127.0.0.1:55432/booking
MIGRATION_DATABASE_URL=postgresql://booking_owner:local_owner_only@127.0.0.1:55432/booking
ALLOW_DEMO_SEED=true

# Administration lives on this exact host; the public booking hosts do not accept admin cookies.
AUTH_BASE_URL=http://haldus.localhost:3107
# Generate a random secret before enabling accounts. Production requires at least 32 characters.
AUTH_SECRET=
# disabled | smtp | capture (capture is restricted to local development/test)
AUTH_MAIL_MODE=disabled
# Optional local-only private directory, outside public/. Do not commit captured messages.
AUTH_MAIL_CAPTURE_DIR=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@broneering.info
